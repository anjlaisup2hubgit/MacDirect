# Copy this file to .env and fill in the values yourself.
# cp .env.example .env
# Names only: docs/03-tech-stack.md decides the final list.

# App
APP_URL=http://localhost:3000
NODE_ENV=development

# Database and auth (for example Supabase or Firebase)
DATABASE_URL=
AUTH_PUBLIC_KEY=
AUTH_SECRET_KEY=

# AI model (Google AI Studio)
GEMINI_API_KEY=
AI_MODEL_DEFAULT=
AI_DAILY_LIMIT_PER_USER=50

# Connectors (only if the MVP uses them)
EMAIL_API_KEY=
PAYMENTS_SECRET_KEY=
PAYMENTS_WEBHOOK_SECRET=
